{
  "name": "backstage-plugin-temporal",
  "version": "0.0.0",
  "private": true,
  "description": "Backstage plugins for Temporal: stream monitoring and workflow diagrams",
  "license": "Apache-2.0",
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build": "backstage-cli repo build --all",
    "tsc": "tsc",
    "test": "backstage-cli repo test --passWithNoTests --watchAll=false",
    "lint": "backstage-cli repo lint",
    "clean": "backstage-cli repo clean",
    "prettier:check": "prettier --check .",
    "changeset": "changeset"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/cli-defaults": "^0.1.7",
    "@changesets/cli": "^2.29.0",
    "@jest/environment-jsdom-abstract": "^30.5.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.0",
    "jsdom": "^27.1.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "undici": "^7.30.1"
  },
  "prettier": "@backstage/cli/config/prettier",
  "packageManager": "yarn@4.13.0"
}
